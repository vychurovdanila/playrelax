# OS
Thumbs.db
.DS_Store

# Editors
.vscode/
.idea/

# Node (на будущее)
node_modules/
npm-debug.log*

# Build
dist/
build/
*.zip

# Local env
.env
.env.local

# Медиафайлы (видео и аудио не коммитим в Git).
# Опираемся на расширения, а не на папку: так playlist.json и прочие
# текстовые файлы в src/assets/ остаются видимыми для Git без исключений.
*.mp3
*.mp4
*.wav
*.ogg
*.m4a
*.webm

# Корневая папка assets/ — здесь только медиа, поэтому игнорируем целиком.
# Якорь `/` — правило не затрагивает src/assets/.
/assets/

# Манифест плейлиста — это код, а не медиа: он версионируется.
# Явное исключение на случай, если выше появится правило на папку.
!src/assets/audio/playlist.json

